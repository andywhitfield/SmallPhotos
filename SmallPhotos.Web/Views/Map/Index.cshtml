@model SmallPhotos.Web.Model.Map.IndexViewModel

@section HeaderScripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.min.css">
}

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.min.js"></script>
@if (Model.Photos.Any()) {
<script type="text/javascript">
    $(function() {
        const map = L.map('map');
        L.DomUtil.addClass(map._container, 'crosshair-cursor-enabled');
        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
        }).addTo(map);
        
        const mapPoints = [];
        @foreach (var photo in Model.Photos) {
        <text>
        mapPoints.push([@(photo.GeoLatitude), @(photo.GeoLongitude)]);
        L.marker([@(photo.GeoLatitude), @(photo.GeoLongitude)], {
            alt: 'Taken: @photo.DateTaken',
            title: 'Taken: @photo.DateTaken',
            icon: L.icon({ iconUrl: '/photo/thumbnail/small/@(photo.PhotoId)/@(photo.Filename)', iconSize: [50, 50] })
        })
        .addTo(map)
        .bindPopup(
            'File: <a href="/gallery/@(photo.PhotoId)/@(photo.Filename)" title="View photo" target="_blank">@photo.Filename</a><br/>'+
            'Taken: @photo.DateTaken<br/>'+
            'Location: <a href="https://www.openstreetmap.org/?mlat=@photo.GeoLatitude&mlon=@photo.GeoLongitude&zoom=15" title="Show photo location on OpenStreetMap: @photo.GeoLocationFull" target="_blank">@photo.GeoLocation</a>'
        );
        </text>
        }
        map.fitBounds(L.latLngBounds(mapPoints));
    });
</script>
}
}

@await Component.InvokeAsync("Navigation")

<article>
    @if (Model.Photos.Any()) {
    <div id="map" class="photos-map"></div>
    } else {
    <div>None of the selected photos have location details.</div>
    }
</article>